# Database Configuration
# For local development, you can use a local PostgreSQL instance or a cloud service
# Example local PostgreSQL: postgresql://user:password@localhost:5432/neurosight
# Example cloud service (Neon, Supabase, etc.): postgresql://user:password@host/dbname

DATABASE_URL=postgresql://postgres:password@localhost:5432/neurosight

